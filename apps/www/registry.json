    {
      "name": "utils",
      "type": "registry:lib",
      "title": "utils",
      "description": "cn(): joins class names and resolves Tailwind conflicts. Shipped by Aedis so its dependencies are explicit.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:file",
      "title": "Theme",
      "description": "The Aedis UI default theme: light, dark and the extra brand theme as CSS variables, Tailwind tokens, accessibility fallbacks and motion utilities. Import it once in your global CSS after tailwindcss.",
      "files": [
        {
          "path": "registry/aedis/styles/theme.css",
          "type": "registry:file",
          "target": "styles/aedis-theme.css"
        }
      ]
    },
