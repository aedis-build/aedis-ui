{
  "name": "@aedis-ui/www",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm registry:build && next dev",
    "registry:build": "shadcn build --output public/r",
    "build": "pnpm registry:build && next build && tsx scripts/headers.ts out",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.registry.json",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "capture": "node visual/capture.mjs",
    "theme": "vitest run test/theme.test.ts -u"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.9.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
